# PolyLife shared gateway — the single entry point (http://localhost:8000).
#
#   /api/teamN/...   -> forward-auth against the core -> team N service
#   everything else  -> core (auth API, SPA, admin)
#
# Each team service is reached by its network alias `teamN-backend` on the
# shared `polylife_net` network (declared in that team's docker-compose.yml).
# Upstreams are resolved at request time, so a team that is not running yet
# only makes its own routes return 502 — it never stops the gateway.
#
# Prefix mapping (public /api/teamN/<rest> -> what the team service expects):
#   team1,3,4,5,6,8  -> /api/<rest>        team2 -> unchanged        team7 -> /<rest>
#
# Rendered by the nginx image's envsubst; only TEAM8_GATEWAY_SECRET is
# substituted (see NGINX_ENVSUBST_FILTER in deploy/docker-compose.gateway.yml).

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

server {
    listen 80;
    server_name _;
    resolver 127.0.0.11 valid=10s;
    client_max_body_size 210m;
    proxy_read_timeout 120s;

    # ── forward-auth sub-request (never reachable from outside) ──────────────
    location = /_auth {
        internal;
        set $core_verify http://core:8000/api/verify;
        proxy_pass              $core_verify;
        proxy_pass_request_body off;
        proxy_set_header        Content-Length "";
        proxy_set_header        Host localhost;
        proxy_set_header        Authorization $http_authorization;
        proxy_set_header        Cookie $http_cookie;
        proxy_set_header        X-Original-URI $request_uri;
    }

    error_page 401 = @unauthorized;
    location @unauthorized {
        default_type application/json;
        return 401 '{"success":false,"message":"Authentication required"}';
    }
    error_page 500 = @auth_unavailable;
    location @auth_unavailable {
        default_type application/json;
        return 503 '{"success":false,"message":"Authentication service is unavailable"}';
    }

    # ── team 1 ───────────────────────────────────────────────────────────────
    location ^~ /api/team1/ {
        include /etc/nginx/snippets/identity.conf;
        include /etc/nginx/snippets/proxy.conf;
        set $upstream http://team1-backend:8000;
        rewrite ^/api/team1/(.*)$ /api/$1 break;
        proxy_pass $upstream;
    }

    # ── team 2 (service already mounts its routes under /api/team2/) ─────────
    location = /api/team2/health/ {
        include /etc/nginx/snippets/anonymous.conf;
        include /etc/nginx/snippets/proxy.conf;
        set $upstream http://team2-backend:8000;
        proxy_pass $upstream;
    }
    location ^~ /api/team2/ {
        include /etc/nginx/snippets/identity.conf;
        include /etc/nginx/snippets/proxy.conf;
        set $upstream http://team2-backend:8000;
        proxy_pass $upstream;
    }

    # ── team 3 ───────────────────────────────────────────────────────────────
    location ^~ /api/team3/ {
        include /etc/nginx/snippets/identity.conf;
        include /etc/nginx/snippets/proxy.conf;
        set $upstream http://team3-backend:8000;
        rewrite ^/api/team3/(.*)$ /api/$1 break;
        proxy_pass $upstream;
    }

    # ── team 4 (storefront browsing is public; cart and admin are not) ───────
    location = /api/team4/health/ {
        include /etc/nginx/snippets/anonymous.conf;
        include /etc/nginx/snippets/proxy.conf;
        set $upstream http://team4-backend:8000;
        rewrite ^/api/team4/(.*)$ /api/$1 break;
        proxy_pass $upstream;
    }
    location ^~ /api/team4/store/ {
        include /etc/nginx/snippets/anonymous.conf;
        include /etc/nginx/snippets/proxy.conf;
        set $upstream http://team4-backend:8000;
        rewrite ^/api/team4/(.*)$ /api/$1 break;
        proxy_pass $upstream;
    }
    location ^~ /api/team4/supplements/ {
        include /etc/nginx/snippets/anonymous.conf;
        include /etc/nginx/snippets/proxy.conf;
        set $upstream http://team4-backend:8000;
        rewrite ^/api/team4/(.*)$ /api/$1 break;
        proxy_pass $upstream;
    }
    location ^~ /api/team4/store/admin/ {
        include /etc/nginx/snippets/identity.conf;
        include /etc/nginx/snippets/proxy.conf;
        set $upstream http://team4-backend:8000;
        rewrite ^/api/team4/(.*)$ /api/$1 break;
        proxy_pass $upstream;
    }
    location ^~ /api/team4/supplements/admin/ {
        include /etc/nginx/snippets/identity.conf;
        include /etc/nginx/snippets/proxy.conf;
        set $upstream http://team4-backend:8000;
        rewrite ^/api/team4/(.*)$ /api/$1 break;
        proxy_pass $upstream;
    }
    location ^~ /api/team4/ {
        include /etc/nginx/snippets/identity.conf;
        include /etc/nginx/snippets/proxy.conf;
        set $upstream http://team4-backend:8000;
        rewrite ^/api/team4/(.*)$ /api/$1 break;
        proxy_pass $upstream;
    }

    # ── team 5 ───────────────────────────────────────────────────────────────
    location ^~ /api/team5/ {
        include /etc/nginx/snippets/identity.conf;
        include /etc/nginx/snippets/proxy.conf;
        set $upstream http://team5-backend:8000;
        rewrite ^/api/team5/(.*)$ /api/$1 break;
        proxy_pass $upstream;
    }

    # ── team 6 ───────────────────────────────────────────────────────────────
    location = /api/team6/health {
        include /etc/nginx/snippets/anonymous.conf;
        include /etc/nginx/snippets/proxy.conf;
        set $upstream http://team6-backend:8000;
        rewrite ^/api/team6/(.*)$ /api/$1 break;
        proxy_pass $upstream;
    }
    location ^~ /api/team6/ {
        include /etc/nginx/snippets/identity.conf;
        include /etc/nginx/snippets/proxy.conf;
        set $upstream http://team6-backend:8000;
        rewrite ^/api/team6/(.*)$ /api/$1 break;
        proxy_pass $upstream;
    }

    # ── team 7 (FastAPI: routes live at the service root; includes WebSocket) ─
    location ^~ /api/team7/ {
        include /etc/nginx/snippets/identity.conf;
        include /etc/nginx/snippets/proxy.conf;
        set $upstream http://team7-backend:8000;
        rewrite ^/api/team7/(.*)$ /$1 break;
        proxy_pass $upstream;
        proxy_read_timeout 3600s;
        proxy_buffering off;
    }

    # ── team 8 (also requires the shared gateway secret) ─────────────────────
    location ^~ /api/team8/ {
        include /etc/nginx/snippets/identity.conf;
        include /etc/nginx/snippets/proxy.conf;
        proxy_set_header X-Gateway-Secret "${TEAM8_GATEWAY_SECRET}";
        set $upstream http://team8-backend:8000;
        rewrite ^/api/team8/(.*)$ /api/$1 break;
        proxy_pass $upstream;
    }

    # An unknown /api/teamN/ must not fall through to the SPA catch-all.
    location ~ ^/api/team[0-9]+/ {
        default_type application/json;
        return 404 '{"success":false,"message":"Unknown team service"}';
    }

    # ── everything else belongs to the core ──────────────────────────────────
    location / {
        include /etc/nginx/snippets/proxy.conf;
        set $core http://core:8000;
        proxy_pass $core;
    }
}
